# Copy to .env and fill in. Never commit real secrets.

# HTTP
PORT=3000

# Inbound integration webhook HMAC secret (ADR 0005). Required for the webhook
# endpoint to accept deliveries.
WEBHOOK_SIGNING_SECRET=change-me

# Session auth (ADR 0006). JWT_SECRET signs user bearer tokens; JWT_TTL sets their
# lifetime (default 12h). Use a strong, unique secret in production.
JWT_SECRET=change-me-too
JWT_TTL=12h

# Outbound webhooks to the Tour Agency platform (ADR 0005). With no URL set,
# outbound deliveries are dropped with a warning (safe dev default). The body is
# HMAC-signed with OUTBOUND_WEBHOOK_SECRET.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=change-me-outbound

# PostgreSQL connection (used once the Prisma client is generated — see
# prisma/README.md). Not required for the in-memory dev/test wiring.
DATABASE_URL=postgresql://user:pass@localhost:5432/dmc
