# Copy to .env and fill in. Never commit real secrets.

# HTTP
PORT=3000

# Inbound integration webhook HMAC secret (ADR 0005). Required for the webhook
# endpoint to accept deliveries.
WEBHOOK_SIGNING_SECRET=change-me

# Session auth (ADR 0006). JWT_SECRET signs user bearer tokens; JWT_TTL sets their
# lifetime (default 12h). REQUIRED in production (the app refuses to start without
# it — ADR 0007); a dev placeholder is used otherwise.
JWT_SECRET=change-me-too
JWT_TTL=12h

# Security hardening (ADR 0007).
# CORS allowlist for the SPA / API consumers (comma-separated). Required in prod.
CORS_ORIGINS=http://localhost:5173
# Global rate limit (requests per window per IP) and window length in ms.
RATE_LIMIT_MAX=500
RATE_LIMIT_TTL_MS=60000
# Set NODE_ENV=production to enable fail-closed secret checks.
# NODE_ENV=production

# Outbound webhooks to the Tour Agency platform (ADR 0005). With no URL set,
# outbound deliveries are dropped with a warning (safe dev default). The body is
# HMAC-signed with OUTBOUND_WEBHOOK_SECRET.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=change-me-outbound

# Persistence backend (ADR 0009): "memory" (default) or "prisma".
PERSISTENCE=memory
# PostgreSQL connection, used when PERSISTENCE=prisma (see prisma/README.md and
# docker-compose.yml). Not required for the in-memory dev/test wiring.
DATABASE_URL=postgresql://dmc:dmc@localhost:5432/dmc
